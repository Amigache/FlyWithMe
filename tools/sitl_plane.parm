# Parametros para SITL ArduPlane: marcar el INS como calibrado (evita "3D Accel calibration needed").
# Se pasa con:  ArduPlane.exe ... --defaults <ruta>\tools\sitl_plane.parm
INS_ACCOFFS_X   0.001
INS_ACCOFFS_Y   0.001
INS_ACCOFFS_Z   0.001
INS_ACCSCAL_X   1.001
INS_ACCSCAL_Y   1.001
INS_ACCSCAL_Z   1.001
INS_ACC2OFFS_X  0.001
INS_ACC2OFFS_Y  0.001
INS_ACC2OFFS_Z  0.001
INS_ACC2SCAL_X  1.001
INS_ACC2SCAL_Y  1.001
INS_ACC2SCAL_Z  1.001
INS_ACC3OFFS_X  0.001
INS_ACC3OFFS_Y  0.001
INS_ACC3OFFS_Z  0.001
INS_ACC3SCAL_X  1.001
INS_ACC3SCAL_Y  1.001
INS_ACC3SCAL_Z  1.001
# Sin RC real en SITL: desactivar checks de armado
ARMING_CHECK    0
# Flag de calibracion de giróscopo (si no, el armado pide "Gyros not calibrated")
INS_GYR_CAL     0
